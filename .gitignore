# =============================================================================
# Iso Syndicate — root .gitignore
# =============================================================================

# --- OS / editor ---
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.code-workspace

# --- Environment & secrets ---
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets/
.secrets/

# --- Python / backend ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
env/
backend/.venv/
backend/venv/
backend/local_database.json
backend/**/__pycache__/

# --- Flutter / Dart / frontend ---
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.packages
frontend/.pub-cache/
frontend/.pub/
frontend/build/
frontend/**/Generated.xcconfig
frontend/**/flutter_export_environment.sh
frontend/android/local.properties
frontend/android/.gradle/
frontend/android/app/debug/
frontend/android/app/profile/
frontend/android/app/release/
frontend/android/**/captures/
frontend/ios/Pods/
frontend/ios/.symlinks/
frontend/ios/Flutter/Flutter.framework
frontend/ios/Flutter/Flutter.podspec
frontend/ios/Flutter/Generated.xcconfig
frontend/ios/Flutter/ephemeral/
frontend/macos/Flutter/ephemeral/
frontend/linux/flutter/ephemeral/
frontend/windows/flutter/ephemeral/
frontend/coverage/
*.symbols
*.map.json

# --- Node (if tooling is added later) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# --- Docker / local runtime ---
*.log
docker-data/
.tmp/
tmp/

# --- Misc build artifacts ---
*.cache
*.dill
.cache/
